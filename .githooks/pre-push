#!/bin/sh
# pre-push hook: incrementally update graphify knowledge graph before every push.
#
# This hook runs `graphify . --update` which re-extracts only changed files
# and merges them into the existing graph. It does NOT re-process the entire codebase.
#
# Enable this hook for the whole team:
#   git config core.hooksPath .githooks
#
# To skip the graph update on a specific push, set:
#   SKIP_GRAPHIFY=1 git push

set -e

if [ -n "$SKIP_GRAPHIFY" ]; then
    echo "[graphify] SKIP_GRAPHIFY=1 — skipping update"
    exit 0
fi

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$PROJECT_ROOT" ]; then
    echo "[graphify] not in a git repo — skipping"
    exit 0
fi

cd "$PROJECT_ROOT"

# Check if graphify-out exists (has been initialized)
if [ ! -f "$PROJECT_ROOT/graphify-out/graph.json" ]; then
    echo "[graphify] no existing graph found — skipping (run 'graphify .' first to initialize)"
    exit 0
fi

echo ""
echo "⟳ [graphify] Incrementally updating knowledge graph..."
echo ""

# Use the cached Python interpreter from the last graphify run if available
if [ -f "$PROJECT_ROOT/graphify-out/.graphify_python" ]; then
    GRAPHIFY_PYTHON="$(cat "$PROJECT_ROOT/graphify-out/.graphify_python")"
else
    GRAPHIFY_PYTHON="python3"
fi

# Check that graphify is installed
if ! "$GRAPHIFY_PYTHON" -c "import graphify" 2>/dev/null; then
    echo "[graphify] graphify package not found — trying 'graphify' CLI..."
    if command -v graphify >/dev/null 2>&1; then
        graphify . --update 2>&1
    else
        echo "[graphify] graphify not installed — skipping update"
        echo "[graphify] to install: pip install graphifyy"
        exit 0
    fi
else
    # Run the incremental update via Python
    "$GRAPHIFY_PYTHON" -c "
import sys, json
from graphify.detect import detect_incremental, save_manifest
from pathlib import Path

result = detect_incremental(Path('.'))
new_total = result.get('new_total', 0)
if new_total == 0:
    print('[graphify] No files changed since last run. Nothing to update.')
    sys.exit(0)

# Check what changed
new_files = result.get('new_files', {})
for ftype, files in new_files.items():
    for f in files:
        print(f'  changed: {ftype}  {f}')

Path('graphify-out/.graphify_incremental.json').write_text(json.dumps(result))

# Determine if only code changed
code_exts = {'.py','.ts','.js','.go','.rs','.java','.cpp','.c','.rb','.swift','.kt','.cs','.scala','.php','.cc','.cxx','.hpp','.h','.kts','.dart','.yaml','.yml'}
all_changed = [f for files in new_files.values() for f in files]
code_only = all(Path(f).suffix.lower() in code_exts for f in all_changed)
print(f'[graphify] {new_total} new/changed files — {\"code-only (fast)\" if code_only else \"full extraction\"}')
Path('graphify-out/.graphify_code_only').write_text('true' if code_only else 'false')
print(json.dumps({'new_total': new_total, 'code_only': code_only}))
" 2>&1

    INCREMENTAL=$(cat "$PROJECT_ROOT/graphify-out/.graphify_incremental.json" 2>/dev/null)
    if [ -z "$INCREMENTAL" ] || echo "$INCREMENTAL" | "$GRAPHIFY_PYTHON" -c "import sys,json; d=json.load(sys.stdin); sys.exit(0 if d.get('new_total',0)==0 else 1)" 2>/dev/null; then
        # No changes
        rm -f "$PROJECT_ROOT/graphify-out/.graphify_incremental.json" "$PROJECT_ROOT/graphify-out/.graphify_code_only"
        exit 0
    fi

    CODE_ONLY=$(cat "$PROJECT_ROOT/graphify-out/.graphify_code_only" 2>/dev/null)

    echo "[graphify] Running incremental extraction..."

    # Step 1: Save old graph for diff
    cp "$PROJECT_ROOT/graphify-out/graph.json" "$PROJECT_ROOT/graphify-out/.graphify_old.json"

    # Step 2: Run AST extraction if code files changed
    if echo "$INCREMENTAL" | "$GRAPHIFY_PYTHON" -c "import sys,json; d=json.load(sys.stdin); print(d.get('new_total',0))" | grep -q '[1-9]'; then
        "$GRAPHIFY_PYTHON" -c "
import json
from graphify.extract import collect_files, extract
from pathlib import Path

new = json.loads(Path('graphify-out/.graphify_incremental.json').read_text())
new_code = [f for f in new.get('new_files',{}).get('code',[])]
code_files = []
for f in new_code:
    p = Path(f)
    if p.is_dir():
        code_files.extend(collect_files(p))
    else:
        code_files.append(p)

if code_files:
    result = extract(code_files)
    Path('graphify-out/.graphify_ast.json').write_text(json.dumps(result, indent=2))
    print(f'[graphify] AST: {len(result[\"nodes\"])} nodes, {len(result[\"edges\"])} edges')
else:
    existing = Path('graphify-out/.graphify_ast.json')
    if existing.exists():
        print('[graphify] Using existing AST data')
    else:
        Path('graphify-out/.graphify_ast.json').write_text(json.dumps({'nodes':[],'edges':[],'input_tokens':0,'output_tokens':0}))
        print('[graphify] No code files to extract')
" 2>&1
    fi

    # Step 3: Semantic extraction only if non-code files changed
    if [ "$CODE_ONLY" != "true" ]; then
        echo "[graphify] Running semantic extraction (non-code changes detected)..."
        # Use graphify's internal build+merge pipeline
        "$GRAPHIFY_PYTHON" -c "
import json
from graphify.build import build_from_json
from graphify.export import to_json
from networkx.readwrite import json_graph
import networkx as nx
from pathlib import Path

# Load existing graph
existing_data = json.loads(Path('graphify-out/graph.json').read_text())
G_existing = json_graph.node_link_graph(existing_data, edges='links')

# Load new extraction
new = json.loads(Path('graphify-out/.graphify_extract.json').read_text()) if Path('graphify-out/.graphify_extract.json').exists() else {'nodes':[],'edges':[],'hyperedges':[]}
sem = json.loads(Path('graphify-out/.graphify_semantic.json').read_text()) if Path('graphify-out/.graphify_semantic.json').exists() else {'nodes':[],'edges':[],'hyperedges':[]}
ast = json.loads(Path('graphify-out/.graphify_ast.json').read_text()) if Path('graphify-out/.graphify_ast.json').exists() else {'nodes':[],'edges':[],'hyperedges':[]}

# Merge AST + semantic
seen = {n['id'] for n in ast['nodes']}
merged_nodes = list(ast['nodes'])
for n in sem['nodes']:
    if n['id'] not in seen:
        merged_nodes.append(n)
        seen.add(n['id'])

merged_edges = ast['edges'] + sem['edges']
merged_hyperedges = sem.get('hyperedges', [])
G_new = build_from_json({'nodes': merged_nodes, 'edges': merged_edges, 'hyperedges': merged_hyperedges})

# Merge into existing graph
G_existing.update(G_new)
print(f'[graphify] Merged: {G_existing.number_of_nodes()} nodes, {G_existing.number_of_edges()} edges')

# Save to graph.json
to_json(G_existing, {}, 'graphify-out/graph.json')
print('[graphify] graph.json updated')
" 2>&1
    fi

    # Step 4: Show diff
    "$GRAPHIFY_PYTHON" -c "
import json
from graphify.analyze import graph_diff
from networkx.readwrite import json_graph
import networkx as nx
from pathlib import Path

old_data = json.loads(Path('graphify-out/.graphify_old.json').read_text())
new_data = json.loads(Path('graphify-out/graph.json').read_text())

G_old = json_graph.node_link_graph(old_data, edges='links')
G_new = json_graph.node_link_graph(new_data, edges='links')

diff = graph_diff(G_old, G_new)
print(f'[graphify] {diff[\"summary\"]}')
if diff.get('new_nodes'):
    for n in diff['new_nodes'][:5]:
        print(f'  + node: {n[\"label\"]}')
if diff.get('new_edges'):
    print(f'  + {len(diff[\"new_edges\"])} new edges')
" 2>&1

    # Cleanup
    rm -f "$PROJECT_ROOT/graphify-out/.graphify_old.json" \
          "$PROJECT_ROOT/graphify-out/.graphify_incremental.json" \
          "$PROJECT_ROOT/graphify-out/.graphify_code_only"
fi

echo ""
echo "✓ [graphify] Knowledge graph updated — ready to push."
echo "   (set SKIP_GRAPHIFY=1 to skip next time)"
echo ""
